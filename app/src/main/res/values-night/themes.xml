<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DisasterAlert" parent="android:Theme.Material.NoActionBar">
        <!-- Status Bar & Navigation Bar Colors for Dark Theme (Near Green) -->
        <item name="android:statusBarColor">#0B1412</item>
        <item name="android:navigationBarColor">#0B1412</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#0B1412</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_disaster_shield</item>
    </style>
</resources>
